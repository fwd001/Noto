{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notera",
  "version": "0.0.8",
  "identifier": "app.notera",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notera",
        "width": 1240,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "Local-first 笔记",
    "longDescription": "Notera —— 数据在你自己的 WebDAV 上，离线可用，自动同步。",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
      "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "minSdkVersion": 24
    },
    "fileAssociations": [
      {
        "ext": ["md", "txt"],
        "name": "Text note",
        "description": "导入为笔记",
        "role": "Editor"
      }
    ]
  }
}
